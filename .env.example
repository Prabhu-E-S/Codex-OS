# Codex OS - Environment Configuration

# Database Connection (PostgreSQL or SQLite)
# PostgreSQL format: postgresql+psycopg2://username:password@localhost:5432/codex_os
# If left empty, Codex OS falls back to local SQLite: sqlite:///./codex_os.db
DATABASE_URL=postgresql+psycopg2://postgres:postgres@localhost:5432/codex_os

# Backend API Configuration
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000
BACKEND_URL=http://localhost:8000
CORS_ORIGINS=http://localhost:5173,http://localhost:3000,http://127.0.0.1:5173

# Frontend API URL Configuration
NEXT_PUBLIC_API_URL=http://localhost:8000
VITE_API_URL=http://localhost:8000

# Codex Execution Engine Configuration (Phase 2)
# Specify the command or path to the Codex executable. If left empty, system PATH is checked.
# CODEX_COMMAND=codex
CODEX_EXECUTION_TIMEOUT=900

# Git Worktree System Configuration (Phase 3)
# Base directory where isolated worktree workspaces are created
CODEX_WORKSPACE_ROOT=./workspaces
# Git provider implementation: 'real' for production Git worktree, 'mock' for tests/dev
CODEX_GIT_PROVIDER=real

# Docker Sandbox Engine Configuration (Phase 4)
# Base Docker image for the sandbox container
DOCKER_SANDBOX_IMAGE=python:3.12-slim
# CPU limit (e.g. 1.0 for 1 CPU core)
DOCKER_SANDBOX_CPU_LIMIT=1.0
# Memory limit (e.g. 512m, 1g)
DOCKER_SANDBOX_MEMORY_LIMIT=512m
# Default command timeout in seconds
DOCKER_SANDBOX_TIMEOUT=60
# Network isolation: 'none' for zero-network security, 'bridge' if dependencies require internet
DOCKER_SANDBOX_NETWORK=none
# Maximum process/PID limit inside container
DOCKER_SANDBOX_PIDS_LIMIT=128
# Docker provider implementation: 'real' for live Docker daemon, 'mock' for daemon-free dev/testing
DOCKER_SANDBOX_PROVIDER=real
# Optional non-root user inside container
# DOCKER_SANDBOX_USER=codex

# Security Scanner Engine Configuration (Phase 6)
# Enable automated security scanners
SECURITY_SCANNING_ENABLED=true
# Comma-separated list of enabled scanner providers
SECURITY_SCANNERS=pattern_scanner,bandit,pip-audit,npm-audit,semgrep,gitleaks
# Network access for security scanners (default false for strict offline isolation)
SECURITY_SCAN_NETWORK=false

# Autonomous Orchestrator Configuration (Phase 7)
ORCHESTRATOR_ENABLED=true
ORCHESTRATOR_DEFAULT_MAX_ITERATIONS=3
ORCHESTRATOR_MAX_ITERATIONS_LIMIT=10
ORCHESTRATOR_DEFAULT_AGENT_TIMEOUT=900
ORCHESTRATOR_TOTAL_RUN_TIMEOUT=3600

# Evaluation & Engineering Score Configuration (Phase 8)
EVALUATION_ENABLED=true
EVALUATION_SCORE_VERSION=v1
EVALUATION_WEIGHT_CORRECTNESS=0.30
EVALUATION_WEIGHT_TEST_COVERAGE=0.15
EVALUATION_WEIGHT_SECURITY=0.20
EVALUATION_WEIGHT_MAINTAINABILITY=0.15
EVALUATION_WEIGHT_PERFORMANCE=0.10
EVALUATION_WEIGHT_REGRESSION_RISK=0.10
